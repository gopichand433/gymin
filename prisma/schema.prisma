generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  avatarUrl     String?
  role          String    @default("USER")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile           UserProfile?
  workoutPlans      WorkoutPlan[]
  workoutSessions   WorkoutSession[]
  personalRecords   PersonalRecord[]
  nutritionLogs     NutritionLog[]
  stepLogs          StepLog[]
  weightLogs        WeightLog[]
  bodyMeasurements  BodyMeasurement[]
  userAchievements  UserAchievement[]
  notifications     Notification[]
  aiConversations   AIConversation[]

  @@index([email])
}

model UserProfile {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  age                     Int?
  gender                  String?   // MALE, FEMALE, OTHER
  heightCm                Float?
  weightKg                Float?
  targetWeightKg          Float?
  mainGoal                String    // BUILD_MUSCLE, IMPROVE_STRENGTH, IMPROVE_FITNESS, MAINTAIN_WEIGHT, LOSE_WEIGHT, GENERAL_HEALTH
  experienceLevel         String    // BEGINNER, INTERMEDIATE, ADVANCED
  workoutDaysPerWeek      Int       @default(4)
  workoutDurationMinutes  Int       @default(45)
  workoutLocation         String    @default("GYM") // GYM, HOME, BOTH
  equipmentList           String    @default("[]") // JSON string array of equipment
  activityLevel           String    @default("MODERATE") // SEDENTARY, LIGHT, MODERATE, VERY_ACTIVE, EXTRA_ACTIVE
  
  calorieTarget           Int       @default(2200)
  proteinTarget           Int       @default(140)
  carbsTarget             Int       @default(250)
  fatTarget               Int       @default(70)
  waterTargetMl           Int       @default(3000)
  stepTarget              Int       @default(10000)
  
  units                   String    @default("METRIC") // METRIC (kg, cm), IMPERIAL (lbs, in)
  theme                   String    @default("dark")
  emailNotifications      Boolean   @default(true)
  pushNotifications       Boolean   @default(true)
  
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Exercise {
  id                    String    @id @default(cuid())
  name                  String    @unique
  slug                  String    @unique
  primaryMuscle         String    // Chest, Back, Shoulders, Biceps, Triceps, Legs, Glutes, Calves, Abs, Cardio, Full Body
  secondaryMuscles      String    @default("[]") // JSON array of string names
  equipment             String    // Barbell, Dumbbells, Machine, Cable, Bodyweight, Resistance Band, Bench, Pull-up Bar
  difficulty            String    // BEGINNER, INTERMEDIATE, ADVANCED
  instructions          String    // JSON array of step-by-step instructions
  safetyTips            String    @default("[]") // JSON array
  commonMistakes        String    @default("[]") // JSON array
  recommendedSets       Int       @default(3)
  recommendedReps       Int       @default(10)
  recommendedRestSec    Int       @default(60)
  demoType              String    @default("SVG_ANIMATION") // SVG_ANIMATION, VIDEO_URL
  demoData              String?   // Motion path / SVG animation config
  createdAt             DateTime  @default(now())

  workoutExercises      WorkoutExercise[]
  workoutSets           WorkoutSet[]
  personalRecords       PersonalRecord[]

  @@index([primaryMuscle])
  @@index([equipment])
  @@index([difficulty])
}

model WorkoutPlan {
  id          String    @id @default(cuid())
  userId      String?   // null for system preset templates
  name        String
  description String?
  splitType   String    // 3_DAY_FULL_BODY, 4_DAY_UPPER_LOWER, 5_DAY_SPLIT, 6_DAY_PPL, CUSTOM
  isCustom    Boolean   @default(false)
  isActive    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  days        WorkoutDay[]
  sessions    WorkoutSession[]

  @@index([userId])
}

model WorkoutDay {
  id          String    @id @default(cuid())
  planId      String
  name        String    // e.g. "Chest & Triceps", "Push Day A", "Upper Body"
  dayOfWeek   Int?      // 1 = Monday ... 7 = Sunday, or null
  order       Int       @default(0)
  
  plan        WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  exercises   WorkoutExercise[]

  @@index([planId])
}

model WorkoutExercise {
  id              String      @id @default(cuid())
  workoutDayId    String
  exerciseId      String
  targetSets      Int         @default(3)
  targetReps      String      @default("8-12")
  targetRestSec   Int         @default(60)
  order           Int         @default(0)

  workoutDay      WorkoutDay  @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)
  exercise        Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([workoutDayId])
  @@index([exerciseId])
}

model WorkoutSession {
  id              String      @id @default(cuid())
  userId          String
  planId          String?
  dayName         String
  startedAt       DateTime    @default(now())
  completedAt     DateTime?
  durationSec     Int         @default(0)
  totalVolumeKg   Float       @default(0)
  totalSets       Int         @default(0)
  caloriesBurned  Int         @default(0)
  notes           String?
  createdAt       DateTime    @default(now())

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            WorkoutPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  sets            WorkoutSet[]

  @@index([userId])
  @@index([createdAt])
}

model WorkoutSet {
  id              String          @id @default(cuid())
  sessionId       String
  exerciseId      String
  setNumber       Int
  targetReps      Int             @default(10)
  actualReps      Int             @default(0)
  weightKg        Float           @default(0)
  isCompleted     Boolean         @default(false)
  isPr            Boolean         @default(false)
  createdAt       DateTime        @default(now())

  session         WorkoutSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise        Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([exerciseId])
}

model PersonalRecord {
  id            String    @id @default(cuid())
  userId        String
  exerciseId    String
  maxWeightKg   Float
  maxReps       Int
  estimated1RM  Float
  achievedAt    DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise      Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([userId, exerciseId])
  @@index([userId])
}

model Food {
  id              String    @id @default(cuid())
  name            String
  category        String    // Protein, Carbohydrates, Fruits, Vegetables, Indian Dishes, Snacks, Beverages, Dairy
  subcategory     String?
  caloriesPer100  Float
  proteinPer100   Float
  carbsPer100     Float
  fatPer100       Float
  fiberPer100     Float     @default(0)
  servingUnits    String    // JSON string e.g. [{"unit":"g","multiplier":1},{"unit":"cup","multiplier":2.4}]
  isIndian        Boolean   @default(false)
  isVeg           Boolean   @default(true)
  notes           String?
  createdAt       DateTime  @default(now())

  nutritionLogs   NutritionLog[]

  @@index([name])
  @@index([category])
  @@index([isIndian])
}

model NutritionLog {
  id          String    @id @default(cuid())
  userId      String
  date        String    // YYYY-MM-DD
  mealType    String    // BREAKFAST, LUNCH, DINNER, SNACK
  foodId      String?
  foodName    String
  servingUnit String    @default("g") // g, ml, cup, bowl, piece, serving, tbsp, tsp
  quantity    Float     @default(100)
  calories    Float
  protein     Float
  carbs       Float
  fat         Float
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  food        Food?     @relation(fields: [foodId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([mealType])
}

model StepLog {
  id        String    @id @default(cuid())
  userId    String
  date      String    // YYYY-MM-DD
  steps     Int       @default(0)
  target    Int       @default(10000)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model WeightLog {
  id        String    @id @default(cuid())
  userId    String
  date      String    // YYYY-MM-DD
  weightKg  Float
  notes     String?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model BodyMeasurement {
  id        String    @id @default(cuid())
  userId    String
  date      String    // YYYY-MM-DD
  chestCm   Float?
  waistCm   Float?
  hipsCm    Float?
  armsCm    Float?
  thighsCm  Float?
  calvesCm  Float?
  notes     String?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model Achievement {
  id                    String    @id @default(cuid())
  code                  String    @unique // FIRST_WORKOUT, STREAK_7, STREAK_30, WORKOUTS_10, FIRST_PR, STEPS_100K, NUTRITION_7
  title                 String
  description           String
  icon                  String    // Lucide icon name or emoji
  category              String    // WORKOUT, STREAK, STRENGTH, NUTRITION, STEPS
  requirementThreshold  Int       @default(1)
  
  userAchievements      UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  title       String
  message     String
  type        String    @default("INFO") // WORKOUT, NUTRITION, PR, STREAK, INFO
  isRead      Boolean   @default(false)
  link        String?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model AIConversation {
  id          String      @id @default(cuid())
  userId      String
  title       String      @default("Fitness Consultation")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    AIMessage[]

  @@index([userId])
}

model AIMessage {
  id              String          @id @default(cuid())
  conversationId  String
  role            String          // "user" | "assistant" | "system"
  content         String
  cardType        String?         // WORKOUT_CARD, NUTRITION_CARD, PROGRESS_CARD, null
  cardData        String?         // JSON string for structured UI cards
  createdAt       DateTime        @default(now())

  conversation    AIConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}
