# Supabase PostgreSQL Database Connection
# 1. Transaction Pooler URL (Port 6543) - Used by Prisma Client for queries
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Direct Connection URL (Port 5432) - Used for Prisma migrations and db push
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# JWT Secret for Session Management
JWT_SECRET="gymin_ultra_secure_jwt_secret_token_key_2026_fitness"

# Google Gemini API Key (Optional)
GEMINI_API_KEY=""

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
